{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hi-html-viewer",
  "version": "1.6.2",
  "identifier": "net.oneblockh.hi-html-viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "hi-html-viewer",
        "width": 800,
        "height": 600,
        "minWidth":575,
        "minHeight":500,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
